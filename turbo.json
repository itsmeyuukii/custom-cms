{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "NEXTAUTH_URL", "CMS_API_URL"]
    },
    "lint": {},
    "typecheck": {},
    "e2e": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "NEXTAUTH_URL",
        "SEED_USER_PASSWORD"
      ]
    }
  }
}
