# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/custom_cms?schema=public"

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: password for the seeded admin/editor/viewer users (npm run db:seed).
# Falls back to "changeme123" if unset - fine for local dev, but always set
# this to a real value before seeding a shared or production database.
SEED_USER_PASSWORD=

# Vercel Blob (media uploads, see docs/MEDIA_PLAN.md). Create a Blob store
# under the Vercel project's Storage tab, then copy its read/write token here.
BLOB_READ_WRITE_TOKEN=
